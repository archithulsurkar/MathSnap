# Which model backend to use: "auto" (default), "ollama", "openai" or "gemini".
# auto  — probe local Ollama first, fall back to Gemini if it is not ready.
# An explicit name is honoured even when that backend is unhealthy, so a
# deliberate choice fails loudly instead of silently running somewhere else.
PROVIDER=auto

# --- Ollama (local, no key, no per-page cost) -------------------------------
# Requires Ollama running and the model pulled:  ollama pull qwen2.5vl:7b
# Must be a vision-capable model — the app sends page images.
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_HOST=http://127.0.0.1:11434
# Local generation is slow; raise this if pages time out.
OLLAMA_TIMEOUT_MS=300000
# How long Ollama keeps the model in VRAM between requests. Shorter values free
# memory sooner but make the next upload pay the load again (~44s vs ~25s).
OLLAMA_KEEP_ALIVE=30m
# Context window. A page at 2x is a lot of vision tokens; too small a window
# truncates them silently and degrades extraction.
OLLAMA_NUM_CTX=8192

# --- OpenAI-compatible (hosted or self-hosted) ------------------------------
# Works with any /v1/chat/completions endpoint: OpenAI, Azure, OpenRouter,
# Groq, vLLM, llama.cpp. The model must accept image input.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Requests per minute. Calls are spaced to stay under this instead of
# collecting 429s. Set 0 to disable pacing.
OPENAI_RPM=10
OPENAI_TIMEOUT_MS=180000

# --- Gemini (hosted) --------------------------------------------------------
# Only needed when PROVIDER=gemini or auto falls through to it. Read by the
# backend only, never bundled into the frontend. Copy this file to `.env`
# (gitignored) and put the real key there — this file is committed and must
# never contain a real key.
# Get a key: https://aistudio.google.com/apikey
API_KEY=
# Optional. Overrides the default model when Google retires the current one.
# GEMINI_MODEL=gemini-3.7-flash
# Requests per minute. The free tier allows 5 for gemini-3.7-flash; raise this
# on a paid plan. Set 0 to disable pacing.
GEMINI_RPM=5

# Port the API server listens on. The Angular dev server proxies /api here.
PORT=8787

# --- Runtime provider switching ---------------------------------------------
# The settings panel switches backend without a restart, choosing from a fixed
# list of presets. Keys it sends are held in memory only: never written to disk,
# never logged, never returned to the page.
#
# Those presets are also an allowlist. The panel hands the server a URL to call,
# and an unconstrained one is server-side request forgery — on a reachable
# instance it could be aimed at internal addresses. Set this to true only when
# you need a self-hosted endpoint, and only where you trust everyone who can
# load the page.
ALLOW_CUSTOM_PROVIDER_URL=false
