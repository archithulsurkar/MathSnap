{
  "name": "formula-accessibility-remediator",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "ng serve",
    "build": "ng build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "preview": "npm run build && npm run start",
    "test": "tsx --test \"src/**/*.test.ts\" \"server/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "eval": "tsx eval/run.ts",
    "typecheck": "tsc -p tsconfig.server.json && ng build --configuration development",
    "test:e2e": "node e2e/ui.mjs",
    "test:compile": "tsx e2e/compile.ts",
    "build:exe": "node tools/build-exe.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@google/genai": "^1.33.0",
    "@supabase/supabase-js": "^2.117.2",
    "dompurify": "^3.4.15",
    "express": "^5.2.1",
    "pdfjs-dist": "^6.3.289",
    "rxjs": "^7.8.2",
    "speech-rule-engine": "^5.0.0-rc.4",
    "temml": "^0.13.5",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0"
  }
}
